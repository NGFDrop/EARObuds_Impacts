          "settings": {
            "title": "Puis-je les utiliser pour dormir ou me détendre ?",
            "content": "<p>Absolument.<br/><br/>Ils sont compacts, légers et équipés d’embouts en silicone souple, parfaits pour s’endormir en musique, méditer ou écouter des podcasts en toute tranquillité.</p>"
          }
        },
        "item_KUPJar": {
